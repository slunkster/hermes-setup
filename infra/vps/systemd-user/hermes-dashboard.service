[Unit]
Description=Hermes dashboard (for Hermes Desktop remote gateway, Tailscale only)
After=network-online.target

[Service]
EnvironmentFile=%h/.hermes/.env
ExecStart=%h/.local/bin/hermes dashboard --host <VPS_TAILSCALE_IP> --port 9119 --no-open
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
