#!/bin/bash
# Prompts for the Hermes dashboard password and stores it in ~/.hermes/.env (never echoed).
read -rsp "New dashboard password (min 12 chars): " p1; echo
read -rsp "Repeat: " p2; echo
[ "$p1" = "$p2" ] || { echo "Passwords differ"; exit 1; }
[ ${#p1} -ge 12 ] || { echo "Too short"; exit 1; }
f=~/.hermes/.env; sed -i "/^HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=/d" $f
printf "HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=%s\n" "$p1" >> $f
systemctl --user restart hermes-dashboard && echo "Saved. Dashboard restarted."
